{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "high",
  "autoCompactWindow": "auto",
  "env": {"CLAUDE_CODE_EFFORT_LEVEL": "high"},
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["ai-orchestrator"],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(nice -n 19 cmake:*)",
      "Bash(bash scripts_ci/local_gates.sh:*)",
      "Bash(tools/chunsa_ai.sh:*)"
    ],
    "ask": [],
    "deny": [
      "Edit",
      "Write",
      "Agent",
      "Task",
      "Read(.env)",
      "Read(.env.local)",
      "Bash(claude:*)",
      "Bash(codex:*)",
      "Bash(qwen:*)",
      "Bash(kimi:*)",
      "Bash(abacusai:*)",
      "Bash(fx:*)",
      "Bash(opencode:*)",
      "Bash(omniroute:*)",
      "Bash(tools/oc_guard.sh:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["tools/chunsa_ai.sh *"]
  },
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "ai-orchestrator claude-hook session-start --profile chunsa",
        "timeout": 30
      }]
    }],
    "PreToolUse": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "ai-orchestrator claude-hook pre-tool-use --profile chunsa",
        "timeout": 30
      }]
    }]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "greptile@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false
  }
}
