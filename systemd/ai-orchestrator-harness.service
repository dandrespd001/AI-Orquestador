[Unit]
Description=DeepSeek Harness administrative UI (loopback only)
Requires=ai-orchestrator-broker.service omniroute-hardened.service
After=ai-orchestrator-broker.service omniroute-hardened.service
ConditionPathExists=%h/.local/bin/ai-orchestrator

[Service]
Type=simple
UMask=0077
Environment=AI_ORCHESTRATOR_SOCKET=%h/.local/share/ai-orchestrator/broker/control.sock
Environment=AI_ORCHESTRATOR_CONFIG=%h/.config/ai-orchestrator
Environment=AI_ORCHESTRATOR_SOURCE_CONFIG=%h/.local/share/ai-orchestrator/runtime/config
Environment=AI_ORCHESTRATOR_PYTHON=%h/.local/share/ai-orchestrator/runtime/venv/bin/python
Environment=AI_ORCHESTRATOR_SKILLS_DIR=%h/.local/share/ai-orchestrator/skills
Environment=NO_COLOR=1
WorkingDirectory=/home/adquiod/Imágenes/Project/CHUNSA001
ExecStart=%h/.local/bin/ai-orchestrator harness serve --profile orchestrator-web --port 3080 --workspace /home/adquiod/Imágenes/Project/CHUNSA001
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 20 --retry-delay 1 --retry-connrefused http://127.0.0.1:3080/
Restart=on-failure
RestartSec=2s
TimeoutStartSec=25s
MemoryHigh=2G
MemoryMax=8G
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/bin/ai-orchestrator %h/.config/ai-orchestrator %h/.local/share/ai-orchestrator/runtime %h/.local/share/ai-orchestrator/updates/slots %h/.local/share/uv/python
BindPaths=%h/.local/share/ai-orchestrator /home/adquiod/Documentos/AI-Orchestrator /home/adquiod/Imágenes/Project/CHUNSA001
ReadWritePaths=%h/.local/share/ai-orchestrator /home/adquiod/Documentos/AI-Orchestrator /home/adquiod/Imágenes/Project/CHUNSA001
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
