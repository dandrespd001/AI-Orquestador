[Unit]
Description=AI Orchestrator private storage maintenance
ConditionPathExists=%h/.local/bin/ai-orchestrator

[Service]
Type=oneshot
UMask=0077
ExecStart=%h/.local/bin/ai-orchestrator storage maintain --apply-permissions --purge-metadata
ExecStart=%h/.local/bin/ai-orchestrator storage maintain --bound-journals --apply
# Un ExecStart por base auditada: --compact acepta una sola ruta y exige
# coincidencia exacta con SQLITE_TARGETS. El prefijo '-' evita que una base
# en uso, que compact_sqlite rechaza a proposito, aborte el resto del ciclo.
ExecStart=-%h/.local/bin/ai-orchestrator storage maintain --compact %h/.codex/logs_2.sqlite
ExecStart=-%h/.local/bin/ai-orchestrator storage maintain --compact %h/.codex/state_5.sqlite
ExecStart=-%h/.local/bin/ai-orchestrator storage maintain --compact %h/.omniroute/storage.sqlite
ExecStart=-%h/.local/bin/ai-orchestrator storage maintain --compact %h/.local/share/opencode/opencode.db
ExecStart=-%h/.local/bin/ai-orchestrator storage maintain --compact %h/.minimax_mcp/tasks.db
ExecStart=%h/.local/bin/ai-orchestrator sessions-maintain --retention-days 7 --apply
TimeoutStartSec=30min
MemoryMax=1G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.omniroute %h/.local/share/opencode %h/.codex %h/.claude %h/.kimi-code %h/.minimax_mcp %h/.local/share/ai-orchestrator %h/.config/ai-orchestrator
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
