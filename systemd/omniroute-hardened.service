[Unit]
Description=OmniRoute official-provider gateway (hardened)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
LoadCredentialEncrypted=omniroute_api_key:%h/.config/ai-orchestrator/credentials/omniroute_api_key.cred
LoadCredentialEncrypted=omniroute_storage_encryption_key:%h/.config/ai-orchestrator/credentials/omniroute_storage_encryption_key.cred
ExecStart=%h/.local/bin/ai-orchestrator-omniroute-wrapper
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.omniroute %h/.cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target

